package org.lpu.dev.codes.services;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.Base64;
import java.util.UUID;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class VehicleImageService {
	
	@Transactional
	public String saveImage(String base64Image) throws IOException {

		if (base64Image == null || base64Image.isBlank()) {
			return "/webapps/uploads/vehicles/default.webp";
		}

		// Remove data:image/jpeg;base64,
		String[] parts = base64Image.split(",");
		String imageData = parts.length > 1 ? parts[1] : parts[0];

		byte[] imageBytes = Base64.getDecoder().decode(imageData);

		String fileName = UUID.randomUUID() + ".webp";

		Path uploadDir = Paths.get(System.getProperty("catalina.base"),"webapps", "uploads", "vehicles");

		Files.createDirectories(uploadDir);

		Path filePath = uploadDir.resolve(fileName);

		Files.write(filePath, imageBytes);

		return "/uploads/vehicles/" + fileName;
	}
}